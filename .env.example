# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Operator controls require an out-of-band secret of at least 32 characters.
# Generate one with a cryptographically secure password manager or secret generator.
# The browser never receives it automatically; enter it into the operator login form.
OPERATOR_TOKEN=""
# Bind locally by default. Set HOST explicitly only behind a trusted TLS-terminating proxy.
HOST="127.0.0.1"

# Optional display-only US equity quote snapshots from Finnhub.
# Requires a Finnhub API key and the appropriate market-data entitlements.
# These snapshots are not broker-executable prices and do not enable order routing.
FINNHUB_API_KEY=""
# The adapter polls 5 mapped US equities; polling cannot be set below 30 seconds.
FINNHUB_POLL_INTERVAL_MS="30000"
# Snapshots older than this are marked stale. Defaults to 120 seconds.
FINNHUB_MAX_QUOTE_AGE_MS="120000"
